{
  "name": "knowledge",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^24.12.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "js:lint": "pnpm exec biome ci apps/web packages/contracts",
    "js:fix": "pnpm exec biome check --write apps/web packages/contracts",
    "js:format": "pnpm exec biome format --write apps/web packages/contracts",
    "js:typecheck": "pnpm exec tsc -b --pretty false",
    "web:test": "pnpm --filter web run test",
    "web:dev": "pnpm --filter web run dev",
    "web:build": "pnpm --filter web run build"
  }
}
