{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/**",
      "packages/contracts/**",
      "!apps/web/dist/**",
      "!apps/web/coverage/**",
      "!apps/web/node_modules/**",
      "!packages/contracts/node_modules/**",
      "!packages/contracts/openapi/**",
      "!packages/contracts/generated/README.md",
      "!node_modules/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
