{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestionAcceptedResponse": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "const": true,
            "default": true,
            "title": "Accepted",
            "type": "boolean"
          },
          "ingestion_id": {
            "pattern": "^ing_[0-9a-f]{32}$",
            "title": "Ingestion Id",
            "type": "string"
          }
        },
        "required": [
          "ingestion_id"
        ],
        "title": "IngestionAcceptedResponse",
        "type": "object"
      },
      "IngestionCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "title": "IngestionCreateRequest",
        "type": "object"
      },
      "MatchedCardResponse": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "title": "MatchedCardResponse",
        "type": "object"
      },
      "SearchResponse": {
        "additionalProperties": false,
        "properties": {
          "connected_titles": {
            "items": {
              "type": "string"
            },
            "title": "Connected Titles",
            "type": "array"
          },
          "matched_cards": {
            "items": {
              "$ref": "#/components/schemas/MatchedCardResponse"
            },
            "title": "Matched Cards",
            "type": "array"
          }
        },
        "required": [
          "matched_cards",
          "connected_titles"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "TaxonomyLeafGraphEdgeResponse": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "source_node_id": {
            "exclusiveMinimum": 0.0,
            "title": "Source Node Id",
            "type": "integer"
          },
          "strength": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Strength",
            "type": "number"
          },
          "target_node_id": {
            "exclusiveMinimum": 0.0,
            "title": "Target Node Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "source_node_id",
          "target_node_id",
          "strength"
        ],
        "title": "TaxonomyLeafGraphEdgeResponse",
        "type": "object"
      },
      "TaxonomyLeafGraphNodeResponse": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "scope": {
            "enum": [
              "inner",
              "outer"
            ],
            "title": "Scope",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "scope"
        ],
        "title": "TaxonomyLeafGraphNodeResponse",
        "type": "object"
      },
      "TaxonomyNodeBranchViewResponse": {
        "additionalProperties": false,
        "properties": {
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
            },
            "title": "Breadcrumb",
            "type": "array"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewChildResponse"
            },
            "title": "Children",
            "type": "array"
          },
          "current_node": {
            "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
          },
          "node_kind": {
            "const": "branch",
            "title": "Node Kind",
            "type": "string"
          }
        },
        "required": [
          "node_kind",
          "current_node",
          "breadcrumb",
          "children"
        ],
        "title": "TaxonomyNodeBranchViewResponse",
        "type": "object"
      },
      "TaxonomyNodeLeafViewResponse": {
        "additionalProperties": false,
        "properties": {
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
            },
            "title": "Breadcrumb",
            "type": "array"
          },
          "current_node": {
            "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyLeafGraphEdgeResponse"
            },
            "title": "Edges",
            "type": "array"
          },
          "node_kind": {
            "const": "leaf",
            "title": "Node Kind",
            "type": "string"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyLeafGraphNodeResponse"
            },
            "title": "Nodes",
            "type": "array"
          }
        },
        "required": [
          "node_kind",
          "current_node",
          "breadcrumb",
          "nodes",
          "edges"
        ],
        "title": "TaxonomyNodeLeafViewResponse",
        "type": "object"
      },
      "TaxonomyNodeViewResponse": {
        "discriminator": {
          "mapping": {
            "branch": "#/components/schemas/TaxonomyNodeBranchViewResponse",
            "leaf": "#/components/schemas/TaxonomyNodeLeafViewResponse"
          },
          "propertyName": "node_kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/TaxonomyNodeBranchViewResponse"
          },
          {
            "$ref": "#/components/schemas/TaxonomyNodeLeafViewResponse"
          }
        ]
      },
      "TaxonomyRootViewResponse": {
        "additionalProperties": false,
        "properties": {
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
            },
            "title": "Breadcrumb",
            "type": "array"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewChildResponse"
            },
            "title": "Children",
            "type": "array"
          }
        },
        "required": [
          "breadcrumb",
          "children"
        ],
        "title": "TaxonomyRootViewResponse",
        "type": "object"
      },
      "TaxonomyViewChildResponse": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "minimum": 0.0,
            "title": "Depth",
            "type": "integer"
          },
          "descendant_card_count": {
            "minimum": 1.0,
            "title": "Descendant Card Count",
            "type": "integer"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "is_leaf": {
            "title": "Is Leaf",
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "id",
          "name",
          "depth",
          "is_leaf",
          "descendant_card_count"
        ],
        "title": "TaxonomyViewChildResponse",
        "type": "object"
      },
      "TaxonomyViewNodeResponse": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "minimum": 0.0,
            "title": "Depth",
            "type": "integer"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "is_leaf": {
            "title": "Is Leaf",
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "id",
          "name",
          "depth",
          "is_leaf"
        ],
        "title": "TaxonomyViewNodeResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Knowledge API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/cards": {
      "post": {
        "operationId": "create_ingestion_cards_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionAcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Ingestion",
        "tags": [
          "ingestions"
        ]
      }
    },
    "/search": {
      "get": {
        "operationId": "search_cards_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Query",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Cards",
        "tags": [
          "search"
        ]
      }
    },
    "/taxonomy/view/nodes/{node_id}": {
      "get": {
        "operationId": "get_node_view_taxonomy_view_nodes__node_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "title": "Node Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyNodeViewResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Node View",
        "tags": [
          "taxonomy"
        ]
      }
    },
    "/taxonomy/view/root": {
      "get": {
        "operationId": "get_root_view_taxonomy_view_root_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyRootViewResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Root View",
        "tags": [
          "taxonomy"
        ]
      }
    }
  }
}
