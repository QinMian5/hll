                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Current Manifest",
        "tags": [
          "semantic-map"
        ]
      }
    },
    "/semantic-map/versions/{version}/tiles/regions/{semantic_level}/{z}/{x}/{y}": {
      "get": {
        "operationId": "get_region_tile_semantic_map_versions__version__tiles_regions__semantic_level___z___x___y__get",
        "parameters": [
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "title": "Version",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "semantic_level",
            "required": true,
            "schema": {
              "title": "Semantic Level",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "z",
            "required": true,
            "schema": {
              "title": "Z",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "x",
            "required": true,
            "schema": {
              "title": "X",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "y",
            "required": true,
            "schema": {
              "title": "Y",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SemanticMapTileResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Region Tile",
        "tags": [
          "semantic-map"
        ]
      }
    }
