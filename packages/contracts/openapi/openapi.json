{
  "components": {
    "schemas": {
      "ErrorCode": {
        "enum": [
          "APPLICATION_API_INPUT_INVALID",
          "APPLICATION_INGESTION_PAYLOAD_INVALID",
          "APPLICATION_INGESTION_STATE_CONFLICT",
          "APPLICATION_TAXONOMY_INPUT_INVALID",
          "DOMAIN_KNOWLEDGE_RESOURCE_NOT_FOUND",
          "DOMAIN_KNOWLEDGE_RULE_VIOLATION",
          "DOMAIN_TAXONOMY_RESOURCE_NOT_FOUND",
          "APPLICATION_SEARCH_STATE_CONFLICT",
          "INFRA_DB_CONNECTION_UNAVAILABLE",
          "INFRA_EMBEDDING_SERVICE_UNAVAILABLE",
          "INFRA_QUEUE_UNAVAILABLE",
          "INTERNAL_API_UNEXPECTED_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorPayload"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorPayload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "hint": {
            "minLength": 1,
            "title": "Hint",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "request_id"
        ],
        "title": "ErrorPayload",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestionAcceptedResponse": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "const": true,
            "default": true,
            "title": "Accepted",
            "type": "boolean"
          },
          "ingestion_id": {
            "pattern": "^ing_[0-9a-f]{32}$",
            "title": "Ingestion Id",
            "type": "string"
          }
        },
        "required": [
          "ingestion_id"
        ],
        "title": "IngestionAcceptedResponse",
        "type": "object"
      },
      "IngestionCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "title": "IngestionCreateRequest",
        "type": "object"
      },
      "MatchedCardResponse": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "current_version": {
            "title": "Current Version",
            "type": "integer"
          },
          "node_id": {
            "title": "Node Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "node_id",
          "current_version",
          "title",
          "content"
        ],
        "title": "MatchedCardResponse",
        "type": "object"
      },
      "SearchResponse": {
        "additionalProperties": false,
        "properties": {
          "connected_titles": {
            "items": {
              "type": "string"
            },
            "title": "Connected Titles",
            "type": "array"
          },
          "matched_cards": {
            "items": {
              "$ref": "#/components/schemas/MatchedCardResponse"
            },
            "title": "Matched Cards",
            "type": "array"
          }
        },
        "required": [
          "matched_cards",
          "connected_titles"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SuggestedEditCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "base_version": {
            "exclusiveMinimum": 0.0,
            "title": "Base Version",
            "type": "integer"
          },
          "suggested_content": {
            "minLength": 1,
            "title": "Suggested Content",
            "type": "string"
          },
          "suggested_title": {
            "minLength": 1,
            "title": "Suggested Title",
            "type": "string"
          }
        },
        "required": [
          "base_version",
          "suggested_title",
          "suggested_content"
        ],
        "title": "SuggestedEditCreateRequest",
        "type": "object"
      },
      "SuggestedEditCreateResponse": {
        "additionalProperties": false,
        "properties": {
          "base_version": {
            "exclusiveMinimum": 0.0,
            "title": "Base Version",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "node_id": {
            "exclusiveMinimum": 0.0,
            "title": "Node Id",
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "node_id",
          "base_version",
          "status",
          "created_at"
        ],
        "title": "SuggestedEditCreateResponse",
        "type": "object"
      },
      "TaxonomyLeafGraphEdgeResponse": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "exclusiveMinimum": 0.0,
            "type": "integer"
          },
          {
            "exclusiveMinimum": 0.0,
            "type": "integer"
          },
          {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          }
        ],
        "type": "array"
      },
      "TaxonomyLeafGraphNodeResponse": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "scope": {
            "enum": [
              "inner",
              "outer"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "id",
          "scope"
        ],
        "title": "TaxonomyLeafGraphNodeResponse",
        "type": "object"
      },
      "TaxonomyLeafNodeDetailResponse": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "content"
        ],
        "title": "TaxonomyLeafNodeDetailResponse",
        "type": "object"
      },
      "TaxonomyLeafNodeDetailsRequest": {
        "additionalProperties": false,
        "properties": {
          "node_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Node Ids",
            "type": "array"
          }
        },
        "title": "TaxonomyLeafNodeDetailsRequest",
        "type": "object"
      },
      "TaxonomyLeafNodeDetailsResponse": {
        "additionalProperties": false,
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyLeafNodeDetailResponse"
            },
            "title": "Nodes",
            "type": "array"
          }
        },
        "required": [
          "nodes"
        ],
        "title": "TaxonomyLeafNodeDetailsResponse",
        "type": "object"
      },
      "TaxonomyNodeBranchViewResponse": {
        "additionalProperties": false,
        "properties": {
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
            },
            "title": "Breadcrumb",
            "type": "array"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewChildResponse"
            },
            "title": "Children",
            "type": "array"
          },
          "current_node": {
            "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
          },
          "node_kind": {
            "const": "branch",
            "title": "Node Kind",
            "type": "string"
          }
        },
        "required": [
          "node_kind",
          "current_node",
          "breadcrumb",
          "children"
        ],
        "title": "TaxonomyNodeBranchViewResponse",
        "type": "object"
      },
      "TaxonomyNodeLeafViewResponse": {
        "additionalProperties": false,
        "properties": {
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
            },
            "title": "Breadcrumb",
            "type": "array"
          },
          "current_node": {
            "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyLeafGraphEdgeResponse"
            },
            "title": "Edges",
            "type": "array"
          },
          "node_kind": {
            "const": "leaf",
            "title": "Node Kind",
            "type": "string"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyLeafGraphNodeResponse"
            },
            "title": "Nodes",
            "type": "array"
          }
        },
        "required": [
          "node_kind",
          "current_node",
          "breadcrumb",
          "nodes",
          "edges"
        ],
        "title": "TaxonomyNodeLeafViewResponse",
        "type": "object"
      },
      "TaxonomyNodeViewResponse": {
        "discriminator": {
          "mapping": {
            "branch": "#/components/schemas/TaxonomyNodeBranchViewResponse",
            "leaf": "#/components/schemas/TaxonomyNodeLeafViewResponse"
          },
          "propertyName": "node_kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/TaxonomyNodeBranchViewResponse"
          },
          {
            "$ref": "#/components/schemas/TaxonomyNodeLeafViewResponse"
          }
        ]
      },
      "TaxonomyRootViewResponse": {
        "additionalProperties": false,
        "properties": {
          "breadcrumb": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewNodeResponse"
            },
            "title": "Breadcrumb",
            "type": "array"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/TaxonomyViewChildResponse"
            },
            "title": "Children",
            "type": "array"
          }
        },
        "required": [
          "breadcrumb",
          "children"
        ],
        "title": "TaxonomyRootViewResponse",
        "type": "object"
      },
      "TaxonomyViewChildResponse": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "minimum": 0.0,
            "title": "Depth",
            "type": "integer"
          },
          "descendant_card_count": {
            "minimum": 0.0,
            "title": "Descendant Card Count",
            "type": "integer"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "is_leaf": {
            "title": "Is Leaf",
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "id",
          "name",
          "depth",
          "is_leaf",
          "descendant_card_count"
        ],
        "title": "TaxonomyViewChildResponse",
        "type": "object"
      },
      "TaxonomyViewNodeResponse": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "minimum": 0.0,
            "title": "Depth",
            "type": "integer"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "is_leaf": {
            "title": "Is Leaf",
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "id",
          "name",
          "depth",
          "is_leaf"
        ],
        "title": "TaxonomyViewNodeResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Knowledge API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/cards": {
      "post": {
        "operationId": "create_ingestion_api_v1_cards_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionAcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Ingestion",
        "tags": [
          "ingestions"
        ]
      }
    },
    "/api/v1/cards/{node_id}/suggested-edits": {
      "post": {
        "operationId": "create_suggested_edit_api_v1_cards__node_id__suggested_edits_post",
        "parameters": [
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Node Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Knowledge-Suggested-By-User-Id",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Knowledge-Suggested-By-User-Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestedEditCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestedEditCreateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Create Suggested Edit",
        "tags": [
          "knowledge-graph"
        ]
      }
    },
    "/api/v1/search": {
      "get": {
        "operationId": "search_cards_api_v1_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Query",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Cards",
        "tags": [
          "search"
        ]
      }
    },
    "/api/v1/taxonomy/view/leaves/{node_id}/details": {
      "post": {
        "operationId": "get_leaf_node_details_api_v1_taxonomy_view_leaves__node_id__details_post",
        "parameters": [
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "title": "Node Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaxonomyLeafNodeDetailsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyLeafNodeDetailsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Leaf Node Details",
        "tags": [
          "taxonomy"
        ]
      }
    },
    "/api/v1/taxonomy/view/nodes/{node_id}": {
      "get": {
        "operationId": "get_node_view_api_v1_taxonomy_view_nodes__node_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "title": "Node Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyNodeViewResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Node View",
        "tags": [
          "taxonomy"
        ]
      }
    },
    "/api/v1/taxonomy/view/root": {
      "get": {
        "operationId": "get_root_view_api_v1_taxonomy_view_root_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyRootViewResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Root View",
        "tags": [
          "taxonomy"
        ]
      }
    }
  }
}
