                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Cards",
        "tags": [
          "search"
        ]
      }
    },
    "/semantic-map/manifest/current": {
      "get": {
        "operationId": "get_current_manifest_semantic_map_manifest_current_get",
        "responses": {
          "200": {
            "content": {
