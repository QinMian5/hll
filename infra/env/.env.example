# abstract: Example API runtime environment template.
# out_of_scope: Real secrets and environment-specific credential rotation workflow.
KNOWLEDGE_API_POSTGRES_DB=knowledge
KNOWLEDGE_API_POSTGRES_USER=knowledge_admin
KNOWLEDGE_API_POSTGRES_PASSWORD=replace_me
KNOWLEDGE_API_DB_USER=knowledge_app
KNOWLEDGE_API_DB_PASSWORD=replace_me
KNOWLEDGE_API_MIGRATION_DB_USER=knowledge_migration
KNOWLEDGE_API_MIGRATION_DB_PASSWORD=replace_me
KNOWLEDGE_API_DATABASE_URL=postgresql+psycopg://knowledge_app:replace_me@postgres:5432/knowledge
KNOWLEDGE_API_MIGRATION_DATABASE_URL=postgresql+psycopg://knowledge_migration:replace_me@postgres:5432/knowledge
KNOWLEDGE_CORPUS_POSTGRES_DB=knowledge_corpus
KNOWLEDGE_CORPUS_POSTGRES_USER=knowledge_corpus_admin
KNOWLEDGE_CORPUS_POSTGRES_PASSWORD=replace_me
KNOWLEDGE_CORPUS_APP_DB_USER=knowledge_corpus_app
KNOWLEDGE_CORPUS_APP_DB_PASSWORD=replace_me
KNOWLEDGE_CORPUS_MIGRATION_DB_USER=knowledge_corpus_migration
KNOWLEDGE_CORPUS_MIGRATION_DB_PASSWORD=replace_me
KNOWLEDGE_CORPUS_DATABASE_URL=postgresql+psycopg://knowledge_corpus_app:replace_me@knowledge_corpus_db:5432/knowledge_corpus
KNOWLEDGE_CORPUS_MIGRATION_DATABASE_URL=postgresql+psycopg://knowledge_corpus_migration:replace_me@knowledge_corpus_db:5432/knowledge_corpus
KNOWLEDGE_API_REDIS_URL=redis://redis:6379/0
KNOWLEDGE_API_EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
KNOWLEDGE_API_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_API_EMBEDDING_API_KEY=replace_me
KNOWLEDGE_API_EMBEDDING_TIMEOUT_SECONDS=10
KNOWLEDGE_API_SEARCH_MAX_MATCHED=5
KNOWLEDGE_API_SEARCH_MAX_CONNECTED=10
KNOWLEDGE_API_EDGE_SIMILARITY_TOP_K=10
KNOWLEDGE_API_EDGE_SIMILARITY_MIN_STRENGTH=0.75
KNOWLEDGE_API_LOG_LEVEL=INFO
KNOWLEDGE_API_LOG_FILE_PATH=logs/api/app.log
KNOWLEDGE_API_LOG_FILE_MAX_BYTES=10485760
KNOWLEDGE_API_LOG_FILE_BACKUP_COUNT=5
