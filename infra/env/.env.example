# abstract: Example API runtime environment template.
# out_of_scope: Real secrets and environment-specific credential rotation workflow.
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge_admin
POSTGRES_PASSWORD=replace_me
APP_DB_USER=knowledge_app
APP_DB_PASSWORD=replace_me
MIGRATION_DB_USER=knowledge_migration
MIGRATION_DB_PASSWORD=replace_me
APP_DATABASE_URL=postgresql+psycopg://knowledge_app:replace_me@postgres:5432/knowledge
MIGRATION_DATABASE_URL=postgresql+psycopg://knowledge_migration:replace_me@postgres:5432/knowledge
KNOWLEDGE_CORPUS_POSTGRES_DB=knowledge_corpus
KNOWLEDGE_CORPUS_POSTGRES_USER=knowledge_corpus_admin
KNOWLEDGE_CORPUS_POSTGRES_PASSWORD=replace_me
KNOWLEDGE_CORPUS_APP_DB_USER=knowledge_corpus_app
KNOWLEDGE_CORPUS_APP_DB_PASSWORD=replace_me
KNOWLEDGE_CORPUS_MIGRATION_DB_USER=knowledge_corpus_migration
KNOWLEDGE_CORPUS_MIGRATION_DB_PASSWORD=replace_me
KNOWLEDGE_CORPUS_DATABASE_URL=postgresql+psycopg://knowledge_corpus_app:replace_me@knowledge_corpus_db:5432/knowledge_corpus
KNOWLEDGE_CORPUS_MIGRATION_DATABASE_URL=postgresql+psycopg://knowledge_corpus_migration:replace_me@knowledge_corpus_db:5432/knowledge_corpus
REDIS_URL=redis://redis:6379/0
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=replace_me
EMBEDDING_TIMEOUT_SECONDS=10
SEARCH_MAX_MATCHED=5
SEARCH_MAX_CONNECTED=10
EDGE_SIMILARITY_TOP_K=10
EDGE_SIMILARITY_MIN_STRENGTH=0.8
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/api/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
