# abstract: Example API runtime environment template.
# out_of_scope: Real secrets and environment-specific credential rotation workflow.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=knowledge
APP_DB_USER=knowledge_app
APP_DB_PASSWORD=replace_me
MIGRATION_DB_USER=knowledge_migration
MIGRATION_DB_PASSWORD=replace_me
REDIS_URL=redis://redis:6379/0
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=replace_me
EMBEDDING_TIMEOUT_SECONDS=10
SEARCH_MAX_MATCHED=5
SEARCH_MAX_CONNECTED=10
EDGE_SIMILARITY_TOP_K=10
EDGE_SIMILARITY_MIN_STRENGTH=0.6
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/api/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
